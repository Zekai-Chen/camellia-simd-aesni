# Makefile for AArch64 Intrinsics vs Assembly Comparison
# Run on ARM64/AArch64 machines only

# Auto-detect ARM CPU target
UNAME_M := $(shell uname -m)
ifneq ($(UNAME_M),aarch64)
$(error This Makefile is for ARM64/AArch64 only. Current: $(UNAME_M))
endif

# Detect ARM CPU variant
CPU_INFO := $(shell cat /proc/cpuinfo 2>/dev/null)
ifneq (,$(findstring Neoverse-V1,$(CPU_INFO)))
    CPU_TARGET = neoverse-v1+crypto
else ifneq (,$(findstring Neoverse-N1,$(CPU_INFO)))
    CPU_TARGET = neoverse-n1+crypto
else ifneq (,$(findstring Cortex-A72,$(CPU_INFO)))
    CPU_TARGET = cortex-a72+crypto
else
    CPU_TARGET = armv8-a+crypto
endif

# Compiler and flags
CC = gcc
CFLAGS_STANDARD = -O2 -static -Wall -march=$(CPU_TARGET)
CFLAGS_CONSERVATIVE = -O1 -static -Wall -march=$(CPU_TARGET) -fno-unroll-loops -fno-tree-vectorize -fno-builtin -fwrapv -fno-strict-aliasing -fno-inline -fno-omit-frame-pointer
ASFLAGS = -march=$(CPU_TARGET)
LDFLAGS = -static

# Source files
TEST_SRC = test_aarch64_intrinsics.c
ASM_SRC = camellia_aarch64_neon_crypto.S
INTRINSICS_SRC = camellia_aarch64_neon_intrinsics.c

# Target executables
TARGET_STANDARD = test_aarch64_intrinsics
TARGET_OPTIMIZED = test_aarch64_intrinsics_optimized

# Object files
OBJS_STANDARD = test_main.o camellia_simd.o
OBJS_OPTIMIZED = test_main_opt.o camellia_simd_opt.o

.PHONY: all clean help standard optimized test

all: standard optimized

standard: $(TARGET_STANDARD)

optimized: $(TARGET_OPTIMIZED)

# Standard build
$(TARGET_STANDARD): $(OBJS_STANDARD)
	@echo "🔗 Linking standard version..."
	$(CC) -O2 $(LDFLAGS) $^ -o $@
	@echo "✅ Built: $@"

test_main.o: $(TEST_SRC)
	@echo "🔧 Compiling C test code (standard)..."
	$(CC) $(CFLAGS_STANDARD) -c $< -o $@

camellia_simd.o: $(ASM_SRC)
	@echo "🔧 Assembling SIMD code..."
	$(CC) $(ASFLAGS) -c $< -o $@

# Optimized build  
$(TARGET_OPTIMIZED): $(OBJS_OPTIMIZED)
	@echo "🔗 Linking optimized version..."
	$(CC) -O1 $(LDFLAGS) $^ -o $@
	@echo "✅ Built: $@"

test_main_opt.o: $(TEST_SRC)
	@echo "🔧 Compiling C test code (conservative)..."
	$(CC) $(CFLAGS_CONSERVATIVE) -c $< -o $@

camellia_simd_opt.o: $(ASM_SRC)  
	@echo "🔧 Assembling SIMD code (optimized)..."
	$(CC) $(ASFLAGS) -c $< -o $@

# Test targets
test: $(TARGET_OPTIMIZED)
	@echo "🚀 Running optimized test with CPU binding..."
	taskset -c 1 ./$(TARGET_OPTIMIZED)

test-standard: $(TARGET_STANDARD)
	@echo "📊 Running standard test..."
	./$(TARGET_STANDARD)

test-both: $(TARGET_STANDARD) $(TARGET_OPTIMIZED)
	@echo "📊 Running both versions for comparison..."
	@echo ""
	@echo "=== Standard Version ==="
	./$(TARGET_STANDARD)
	@echo ""
	@echo "=== Optimized Version ==="  
	taskset -c 1 ./$(TARGET_OPTIMIZED)

# Information
info:
	@echo "🎯 Build Information:"
	@echo "   Architecture: $(UNAME_M)"
	@echo "   CPU Target: $(CPU_TARGET)"
	@echo "   Compiler: $(CC)"
	@echo "   Available targets: $(TARGET_STANDARD), $(TARGET_OPTIMIZED)"

# Clean
clean:
	@echo "🧹 Cleaning up..."
	rm -f *.o $(TARGET_STANDARD) $(TARGET_OPTIMIZED)
	@echo "✅ Clean complete"

# Help
help:
	@echo "🚀 AArch64 Intrinsics vs Assembly Comparison"
	@echo "============================================="
	@echo ""
	@echo "Available targets:"
	@echo "  all           - Build both standard and optimized versions"
	@echo "  standard      - Build standard version"
	@echo "  optimized     - Build optimized version (recommended)"
	@echo "  test          - Run optimized test with CPU binding"
	@echo "  test-standard - Run standard test"
	@echo "  test-both     - Run both versions for comparison"
	@echo "  info          - Show build configuration"
	@echo "  clean         - Remove generated files"
	@echo "  help          - Show this help"
	@echo ""
	@echo "Examples:"
	@echo "  make optimized     # Build optimized version"
	@echo "  make test          # Run performance comparison"
	@echo "  make test-both     # Compare standard vs optimized builds"